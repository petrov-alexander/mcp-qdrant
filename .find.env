QDRANT_READ_ONLY=true
QDRANT_SEARCH_LIMIT=20
TOOL_FIND_DESCRIPTION="ОБЯЗАТЕЛЬНЫЙ ИНСТРУМЕНТ. Используй для поиска кода: определений функций, классов, логики обработки и импортов. При запросах архитектуры и UML-схем извлекай не только запрошенный файл, но и те модули, которые он импортирует, чтобы точно понять связи."
